/target
**/*.rs.bk
*.pdb
proptest-regressions/

# The sample corpus is fetched or generated, never committed: the synthetic images are
# deterministic, and the photographs are not ours to redistribute.
#   cargo run -p brp-bench --bin gen-samples -- samples/
#   pwsh scripts/fetch-photos.ps1
/samples/*.png
/samples/*.webp
/samples/*.jpg
/samples/*.jpeg
/samples/*.brp
/samples/out/
# Large images are opt-in and measured separately; only the note explaining that is committed.
/samples/large/*
!/samples/large/README.md
